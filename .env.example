# Gemini API Key (dùng cho 01-function-calling và 04-lab Google ADK agent)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# WeatherAPI Key (dùng cho 04-lab mcp-server, lấy tại https://www.weatherapi.com)
WEATHERAPI_KEY=your_weatherapi_key_here

# MCP Server URL (dùng cho 04-lab mcp-client)
MCP_SERVER_URL=http://localhost:8085/mcp

# Token xác thực cho 03-production (auth_server.py / auth_client.py)
MCP_AUTH_TOKEN=dev-token-abc123

# Cổng khởi chạy server (mặc định 8085 cho weather mcp-server, 8001 cho auth_server)
PORT=8085
AUTH_PORT=8001

